# LovePilot Agent
LOVEPILOT_TOKEN=replace-with-a-long-random-secret
LOVEPILOT_BOT_TOKEN=replace-with-a-separate-bot-token
LOVEPILOT_READ_TOKEN=replace-with-a-separate-read-only-token
DEEPSEEK_API_KEY=replace-with-your-own-key
DEEPSEEK_MODEL=deepseek-chat
LOVEPILOT_DB=./data/lovepilot.sqlite3

# AstrBot bridge (configure in AstrBot process environment)
LOVEPILOT_URL=http://127.0.0.1:8768
# The plugin transport is ready. The application's global reply switch defaults off.
LOVEPILOT_AUTO_REPLY=true
LOVEPILOT_TIMEOUT=50
LOVEPILOT_BOT_PLATFORM_ID=
LOVEPILOT_COOLDOWN_SECONDS=3
